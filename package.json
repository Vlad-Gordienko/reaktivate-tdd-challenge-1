{
  "name": "reaktivate-tdd-challenge-1-sample-begin",
  "version": "1.0.0",
  "description": "How we create a fast-test architecture from scratch.",
  "keywords": [],
  "main": "src/index.tsx",
  "dependencies": {
    "mobx": "6.3.10",
    "mobx-react": "7.2.1",
    "react": "16.8.6",
    "react-dom": "16.8.6",
    "react-scripts": "3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^11.2.7",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^16.18.0",
    "@types/react": "^16.14.60",
    "@types/react-dom": "^16.9.24",
    "tailwindcss": "^3.4.19",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "start": "NODE_OPTIONS=--openssl-legacy-provider react-scripts start",
    "build:css": "tailwindcss -i ./src/tailwind.input.css -o ./src/tailwind.css",
    "build:css:watch": "tailwindcss -i ./src/tailwind.input.css -o ./src/tailwind.css --watch",
    "prestart": "npm run build:css",
    "build": "NODE_OPTIONS=--openssl-legacy-provider react-scripts build",
    "prebuild": "npm run build:css",
    "test": "NODE_OPTIONS=--openssl-legacy-provider react-scripts test --env=jsdom",
    "test:e2e": "playwright test",
    "eject": "react-scripts eject"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
